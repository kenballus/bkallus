{
    "height": 24,
    "spacing": 4,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["sway/window"],
    "modules-right": ["battery", "pulseaudio", "clock", "tray"],
    "battery": {
        "weighted-average": true,
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "pulseaudio": {
        "on-click": "pavucontrol"
    },
    "clock": {
        "interval": 30,
        "format": "{:%A, %b %d, %I:%M %p}"
    },
    "tray": {
        "spacing": 10
    }
}
